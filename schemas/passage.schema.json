{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://liangsimajing.local/schemas/passage.schema.json",
  "title": "Passage",
  "type": "object",
  "additionalProperties": false,
  "required": ["passage_id", "work", "edition_id", "location", "text_original", "text_normalized", "content_hash", "license_note"],
  "properties": {
    "passage_id": {"type": "string", "pattern": "^(SJ|ZZTJ)-[A-Z0-9-]+$"},
    "work": {"enum": ["史记", "资治通鉴"]},
    "edition_id": {"type": "string", "minLength": 1},
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["juan", "section", "paragraph_index"],
      "properties": {
        "juan": {"type": "integer", "minimum": 1},
        "section": {"type": "string", "minLength": 1},
        "year_label": {"type": ["string", "null"]},
        "chapter_title": {"type": ["string", "null"]},
        "paragraph_index": {"type": "integer", "minimum": 0},
        "char_start": {"type": ["integer", "null"], "minimum": 0},
        "char_end": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "text_original": {"type": "string", "minLength": 1},
    "text_normalized": {"type": "string", "minLength": 1},
    "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "persons": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "places": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "events": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "license_note": {"type": "string", "minLength": 1}
  }
}
